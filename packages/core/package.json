{
  "name": "@waxlens/core",
  "version": "0.0.0",
  "description": "WACZ validation engine — emits a machine-readable JSON report or plain text.",
  "license": "Unlicense",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "main": "dist/public.js",
  "types": "dist/public.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "postbuild": "mkdir -p dist/validate/frictionless && cp src/validate/frictionless/data-package.schema.json dist/validate/frictionless/ && mkdir -p dist/i18n/locales && cp src/i18n/locales/*.json dist/i18n/locales/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "corpus:build": "vitest run test/corpus/build-corpus.test.ts",
    "test:corpus": "vitest run test/corpus/corpus-driven.test.ts",
    "corpus:docs": "vitest run test/corpus/build-docs.test.ts",
    "corpus:docs:check": "WAXLENS_DOCS_CHECK=1 vitest run test/corpus/build-docs.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "dependencies": {
    "@waxlens/contract": "workspace:*",
    "@aws-sdk/client-s3": "^3.1107.0",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "intl-messageformat": "^11.2.13",
    "yauzl-promise": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.5.1",
    "@types/yauzl-promise": "^4.0.1",
    "archiver": "^8.0.0",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^10.10.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
