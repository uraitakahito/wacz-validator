{
  "name": "@wacz-validator/validate-cli",
  "version": "0.0.0",
  "description": "wacz-validator-validate — the non-interactive CLI over @wacz-validator/core. Emits a machine-readable JSON report to stdout.",
  "license": "Unlicense",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "bin": {
    "wacz-validator-validate": "dist/wacz-validator-validate.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && node ../../scripts/gen-build-info.mjs validate-cli && tsc -p tsconfig.build.json",
    "postbuild": "chmod +x dist/wacz-validator-validate.js",
    "typecheck": "node ../../scripts/gen-build-info.mjs validate-cli && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "dependencies": {
    "@wacz-validator/contract": "workspace:*",
    "@wacz-validator/core": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "eslint": "^10.8.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
