{
  "name": "@waxlens/contract",
  "version": "0.0.0",
  "description": "The vocabulary every waxlens surface agrees on — rule profiles, locales, and the CLI exit-code contract. Depends on nothing.",
  "license": "Unlicense",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
