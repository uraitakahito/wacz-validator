{
  "name": "@wacz-validator/tui",
  "version": "0.0.0",
  "description": "Ink TUI for wacz-validator — a thin client that renders the WireReport served by @wacz-validator/daemon.",
  "license": "Unlicense",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "main": "dist/app.js",
  "types": "dist/app.d.ts",
  "bin": {
    "wacz-validator": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && node ../../scripts/gen-build-info.mjs tui && tsc -p tsconfig.build.json",
    "postbuild": "chmod +x dist/cli.js",
    "typecheck": "node ../../scripts/gen-build-info.mjs tui && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "dependencies": {
    "@wacz-validator/daemon": "workspace:*",
    "@wacz-validator/protocol": "workspace:*",
    "commander": "^15.0.0",
    "ink": "^7.0.2",
    "picocolors": "^1.1.1",
    "react": "^19.2.6",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.18",
    "@types/ws": "^8.5.12",
    "eslint": "^10.11.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
