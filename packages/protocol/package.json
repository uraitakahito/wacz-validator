{
  "name": "@waxlens/protocol",
  "version": "0.0.0",
  "description": "Shared wire types for the waxlens daemon protocol (tui / daemon / future browser).",
  "license": "Unlicense",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm typecheck && pnpm lint && pnpm build"
  },
  "dependencies": {
    "@waxlens/contract": "workspace:*",
    "@waxlens/core": "workspace:*"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "typescript": "^7.0.2"
  }
}
