{
  "name": "@wacz-validator/daemon",
  "version": "0.0.0",
  "description": "Stateless HTTP/WS validation daemon — owns @wacz-validator/core, serves the tui and (future) browser clients.",
  "license": "Unlicense",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "wacz-validator-daemon": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && node ../../scripts/gen-build-info.mjs daemon && tsc -p tsconfig.build.json",
    "postbuild": "chmod +x dist/cli.js",
    "typecheck": "node ../../scripts/gen-build-info.mjs daemon && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test"
  },
  "dependencies": {
    "@wacz-validator/contract": "workspace:*",
    "@wacz-validator/core": "workspace:*",
    "@wacz-validator/protocol": "workspace:*",
    "commander": "^15.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ws": "^8.5.12",
    "eslint": "^10.11.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
