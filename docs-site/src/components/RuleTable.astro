---
/**
 * Every rule, straight out of packages/core/src/validate/.
 *
 * The table is generated rather than written because everything in it —
 * name, severity, conformance, per-profile overrides, spec links — already
 * exists in code, and keeping a hand-written copy in two languages would mean
 * three places to update per rule. Prose about *why* a rule exists stays in the
 * page around this component; that is the part worth writing by hand.
 *
 * `lang` switches the column headers **and the spec links**: WACZ has a
 * Japanese translation, so the ja table points at uraitakahito.github.io/specs
 * while en points at specs.webrecorder.net. Specs without a translation
 * (Frictionless, WARC) fall back to the English URL in both.
 *
 * **3 列しかないのは意図的。** 以前は rule / severity / conformance /
 * profile 上書き / 出典 の 5 列で、Starlight の本文幅に 5 列は入りきらず
 * ブラウザがいちばん割れやすい列を潰していた (`lenient: warning (2 件)` が
 * `lenien / t: / warnin / g (2 / 件)` の 5 行に割れる)。
 *
 * 畳み方は「同じ軸のものを同じセルへ」で決めている:
 *   - severity と profile 上書きは**同じ軸**(その指摘をどう扱うか)。既定値の
 *     下に上書きを積むと、両者の関係がセルの中で上下に読める。
 *   - 出典は rule に従属する情報なので rule 名の下へ。
 */
import { rules } from "../lib/extract";

interface Props {
  lang?: "en" | "ja";
}

const { lang = "en" } = Astro.props;

/**
 * rule 名 → 行の id。本文から `[\`x/y\`](#x-y)` で該当行へ飛べるようにする。
 * rule 名は `[a-z-]+/[a-z-]+` なので `/` を `-` にするだけで衝突しない。
 */
const anchor = (name: string): string => name.replace("/", "-");

const head =
  lang === "ja"
    ? { rule: "Rule / 出典", severity: "severity (profile 別)", conformance: "適合レベル" }
    : { rule: "Rule / spec", severity: "Severity (per profile)", conformance: "Conformance" };

const all = rules();

/** 上書きが複数の message に掛かるときに添える数。表の言語で書く。 */
const countOf = (count: number): string =>
  lang === "ja" ? ` (${String(count)} 件)` : ` (${String(count)} messages)`;

/** profile 別の上書き。severity の再割り当てと、適用バージョン範囲の両方。 */
const overridesOf = (rule: (typeof all)[number]): string[] => [
  ...Object.entries(rule.severityByProfile).map(
    ([profile, { levels, count }]) =>
      `${profile}: ${levels.join(" / ")}${count > 1 ? countOf(count) : ""}`,
  ),
  ...Object.entries(rule.profileVersions).map(([profile, range]) => `${profile}: ${range}`),
];
---

<table class="rule-table">
  <thead>
    <tr>
      <th>{head.rule}</th>
      <th>{head.severity}</th>
      <th>{head.conformance}</th>
    </tr>
  </thead>
  <tbody>
    {
      all.map((rule) => (
        <tr id={anchor(rule.name)}>
          <td>
            <code>{rule.name}</code>
            {rule.links.map((link) => (
              <a class="rule-src" href={link.url[lang] ?? link.url.en}>
                {link.label}
              </a>
            ))}
          </td>
          <td>
            {rule.severities.join(" / ")}
            {overridesOf(rule).map((override) => (
              <code class="rule-override">{override}</code>
            ))}
          </td>
          <td>{rule.conformance}</td>
        </tr>
      ))
    }
  </tbody>
</table>
